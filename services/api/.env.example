PORT=8080
# mock … @diggr/core のモックデータ（開発）／ postgres … music_v{n} を読む
DATA_SOURCE=mock
DATABASE_URL=postgres://diggr:diggr@localhost:5432/diggr
MUSIC_SCHEMA=music_v20260901
# 開発時に Pro 権利を強制する
DEV_FORCE_PRO=0

# 匿名 JWT の署名鍵（basic §7.4・技術選定書 §9.1）。本番では必ず設定する
# （NODE_ENV=production かつ未設定だと起動時に例外を投げる）。
JWT_SECRET=dev-insecure-secret-change-me

# RevenueCat の Webhook を検証する共有シークレット（未設定だと検証をスキップする＝開発用）
REVENUECAT_WEBHOOK_SECRET=

# CORS を許可するオリジン（カンマ区切り）。LP・管理画面ができるまでは空でよい
CORS_ORIGINS=
