{
  "name": "diggr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "core:test": "npm run test --workspace @diggr/core",
    "core:typecheck": "npm run typecheck --workspace @diggr/core",
    "api:dev": "npm run dev --workspace @diggr/api",
    "mobile:start": "npm run start --workspace @diggr/mobile",
    "mobile:ios": "npm run ios --workspace @diggr/mobile",
    "mobile:android": "npm run android --workspace @diggr/mobile",
    "typecheck": "npm run core:typecheck && npm run typecheck --workspace @diggr/api && npm run typecheck --workspace @diggr/mobile",
    "test": "npm run core:test"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
