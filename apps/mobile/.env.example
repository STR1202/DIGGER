# local  … 端末内で @diggr/core を直接呼ぶ（サーバー不要。既定）
# http   … services/api を叩く
EXPO_PUBLIC_API_MODE=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# 開発時に固定トークンで認証をスキップしたいとき（本番では未設定にする）
# EXPO_PUBLIC_DEV_TOKEN=

# RevenueCat（未設定ならスタブ実装にフォールバックし、ストアを一切呼ばない）
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# AdMob 広告ユニット ID（未設定なら Google 公式のテスト ID を使う。本番配信前に必ず差し替える）
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
# EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxx/xxxxxxxx

# 法務ページ（legal/README.md の手順でホスティングした後の URL）
# EXPO_PUBLIC_LEGAL_BASE_URL=https://diggr.app/legal
