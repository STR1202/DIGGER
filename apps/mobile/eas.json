{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_MODE": "local"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_MODE": "local"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_MODE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.diggr.app/v1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "testflight": {
      "extends": "production",
      "channel": "preview",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_MODE": "local"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "//": "eas submit 実行時に対話で聞かれる。ここに書けば自動化できる",
        "appleId": "sakataiyo18@gmail.com",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}