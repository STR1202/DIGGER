# infra/.env として VPS 上にだけ置く。リポジトリにはこの .example だけをコミットする
# （本番リリース計画書 §3.6・技術選定書 §9.2）。

# --- ドメイン / TLS ---
DIGGR_DOMAIN=api.diggr.app
DIGGR_ACME_EMAIL=ops@example.com

# --- イメージ ---
# 初回は docker compose build がこの2つを無視してリポジトリから直接ビルドするので、
# 未設定のままで良い。GitHub Actions（.github/workflows/deploy.yml）を後から組んだら、
# ghcr.io/str1202/digger-api:latest のような値に変えて `docker compose pull api` に切り替える。
# API_IMAGE=
# PIPELINE_IMAGE=

# --- DB / キャッシュ ---
POSTGRES_PASSWORD=change-me

# --- 認証 ---
# openssl rand -base64 48 などで生成する。ローテーションする場合は
# 旧トークンの失効猶予を置くため、切替期間だけ両対応の実装に変える。
JWT_SECRET=change-me

# --- 課金 ---
REVENUECAT_WEBHOOK_SECRET=change-me

# --- CORS（LP・管理画面を作るまでは空でよい） ---
CORS_ORIGINS=

# --- データパイプライン（Apple Music Feed、基本設計書 §3.1.2） ---
# false のままなら Apple のカタログ取り込みはスキップされる（FR-01b）。
APPLE_CATALOG_SEARCH=false
# Media Services キー（.p8）の実ファイルパス。クライアントには絶対に置かない。
MEDIA_SERVICES_KEY_FILE=/opt/diggr/secrets/media_services_key.p8
