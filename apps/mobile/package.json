{
  "name": "@diggr/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "expo start --dev-client",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:simulator": "eas build --profile ios-simulator --platform ios"
  },
  "dependencies": {
    "@diggr/core": "*",
    "@shopify/react-native-skia": "1.5.0",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~52.0.11",
    "expo-apple-authentication": "~7.1.3",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.6",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-keep-awake": "~14.0.3",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.1",
    "expo-media-library": "~17.0.6",
    "expo-router": "~4.0.11",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-tracking-transparency": "~5.1.1",
    "expo-updates": "~0.27.5",
    "i18n-js": "^4.5.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^14.7.2",
    "react-native-mmkv": "^3.1.0",
    "react-native-purchases": "^8.2.6",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-view-shot": "^3.8.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.6.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@diggr/core"
      ]
    }
  }
}
